//fazendo o passaro cair

if (global.Morre = 1) {



//fazer os obstáculos pararem
	with(all)
	{
		hspeed = 0
	}
	//fazendo o passaro ter uma animação de morte
hspeed = -1
image_angle +=3
	
	//fazendo o background parar
	layer_hspeed("arvores", 0)
	layer_hspeed("reflexoagua", 0)
	layer_hspeed("reflexoceu", 0)
	layer_hspeed("agua", 0)
	


} 


